root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,psm1,psd1}]
# Windows PowerShell 5.1 parses BOM-less non-ASCII files as the ANSI code page.
charset = utf-8-bom
end_of_line = crlf

[*.bat]
end_of_line = crlf
charset = utf-8

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2
